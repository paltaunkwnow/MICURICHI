API_CORE_PORT=3001
API_CORE_HOST=127.0.0.1
DATABASE_URL=postgresql://curichi:curichi@127.0.0.1:5433/curichi
GEO_SERVICE_URL=http://127.0.0.1:3002
CORS_ORIGENES=http://localhost:3000,http://localhost:3100
# Carpeta de fotos en local (por defecto infra/.storage/fotos)
STORAGE_DIR=
# Prefijo de las URLs de fotos que devuelve la API (vacío = relativo, sirve detrás del rewrite de Next)
PUBLIC_BASE_URL=
COOKIE_SEGURA=0
SESION_DIAS=7
RATE_LIMIT_REPORTES_POR_HORA=10

# --- Secretos. En producción el servicio NO arranca si siguen con el valor de ejemplo.
# Sal del hash de IP para antispam (§13).
IP_HASH_SAL=
# Sal del jitter de la vista pública (§13). Sin ella el desplazamiento se puede revertir:
# la semilla sería el id del reporte, que viaja en la propia respuesta.
JITTER_SAL=
# Token compartido con geo-service para sus rutas internas (invalidar caché de capas).
# Vacío en local: geo-service solo las acepta desde loopback.
GEO_TOKEN_INTERNO=

# Poner a 1 SOLO si hay un proxy propio delante (nginx, ALB) que reescriba X-Forwarded-For.
# Con 1 y sin proxy, cualquiera elige su IP y el rate limit deja de servir.
TRUST_PROXY=0
# Exponer /docs (Swagger UI). Por defecto: sí fuera de producción, no en producción.
EXPONER_DOCS=
# Días que se conserva ip_hash antes del borrado automático (§13).
IP_HASH_RETENCION_DIAS=30
OPENAPI_PATH=
