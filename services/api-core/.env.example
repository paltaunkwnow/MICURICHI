API_CORE_PORT=3001
API_CORE_HOST=127.0.0.1
# [OPCIONAL] [SENSIBLE] URL de la base con el rol de api-core (`curichi_api`, privilegios mínimos,
# migración 0008). Manda sobre DATABASE_URL; vacía cuenta como ausente. Con PostgreSQL en Docker:
#   postgresql://curichi_api:<API_DB_PASSWORD>@localhost:5432/curichi
# En producción va con `?sslmode=require`.
API_DATABASE_URL=
# Se usa solo si API_DATABASE_URL está vacía. En el .env raíz es la del rol DUEÑO del esquema
# (migraciones, seeds, ETL): con ella api-core se conecta con privilegios de más y el arranque lo
# avisa (en producción se niega a servir). Sin ninguna de las dos: PGlite local (ADR 0002).
DATABASE_URL=postgresql://curichi:curichi@127.0.0.1:5433/curichi
GEO_SERVICE_URL=http://127.0.0.1:3002
CORS_ORIGENES=http://localhost:3000,http://localhost:3100
# Zona horaria de la instalación (nombre IANA, no un desfase como -04:00). Vacía = la del contrato
# (America/La_Paz). Se usa para filtrar por día (listado, exportación) y como zona_horaria de
# GET /api/v1/configuracion.
ZONA_HORARIA=
# --- Ciudad del despliegue (contracts 0.7.0, GET /api/v1/configuracion). Una instalación es una
# ciudad: esto reemplaza lo que antes estaba fijado en el JavaScript de cada frontend (centro del
# mapa, locale, nombre). Cada variable vacía o ausente cae en el valor de Santa Cruz de la Sierra
# (CONFIG_DOMINIO.CIUDAD_POR_DEFECTO); una presente pero inválida (locale mal formado, coordenada
# fuera de rango) impide arrancar, con el motivo.
CIUDAD_NOMBRE=
CIUDAD_PAIS=
# BCP 47 canónico para Intl, p. ej. es-BO o es-419 (no es_BO ni es-bo).
CIUDAD_LOCALE=
CIUDAD_CENTRO_LON=
CIUDAD_CENTRO_LAT=
CIUDAD_ZOOM_INICIAL=
# URL base del panel (apps/panel-admin), sin usuario ni contraseña; se normaliza a URL absoluta.
# Viaja como panel_url en GET /api/v1/auth/yo, solo para tecnico, admin y ejecutivo (antes fija en
# el JavaScript público de la app ciudadana). Vacía = sin panel configurado (panel_url: null).
# [OBLIGATORIA en producción, y https] el servicio no arranca sin ella ni con http.
PANEL_ADMIN_URL=
# Carpeta de fotos en local (por defecto infra/.storage/fotos)
STORAGE_DIR=
# Prefijo de las URLs de fotos que devuelve la API (vacío = relativo, sirve detrás del rewrite de Next)
PUBLIC_BASE_URL=
COOKIE_SEGURA=0
SESION_DIAS=7
RATE_LIMIT_REPORTES_POR_HORA=10

# --- Secretos. En producción el servicio NO arranca si siguen con el valor de ejemplo.
# Sal del hash de IP para antispam (§13).
IP_HASH_SAL=
# Sal del jitter de la vista pública (§13). Sin ella el desplazamiento se puede revertir:
# la semilla sería el id del reporte, que viaja en la propia respuesta.
JITTER_SAL=
# [OBLIGATORIA en producción] [SENSIBLE] token compartido con geo-service (`x-token-interno`),
# el MISMO valor en los dos servicios. Con él, geo-service acepta la invalidación de capas y deja
# el resolver de api-core fuera de su cupo por IP (sin él, en una tormenta, crear reportes da 503).
# En producción el servicio NO arranca si falta o tiene menos de 32 caracteres: generalo con
# `openssl rand -hex 32`. Vacío solo en el modo local sin Docker, donde geo-service acepta esas
# llamadas desde loopback.
GEO_TOKEN_INTERNO=

# Saltos de proxy que ESCRIBEN en X-Forwarded-For. 0 si no hay proxy propio delante: con un valor
# mayor y sin proxy, cualquiera elige su IP y el rate limit deja de servir. Con la topología
# prevista (navegador → proxy TLS → Next → api-core) es 1: Next reenvía la cabecera sin añadir
# entrada, y con 2 el cliente vuelve a elegirse la IP (ver src/proxy.ts).
TRUST_PROXY=0
# Exponer /docs (Swagger UI). Por defecto: sí fuera de producción, no en producción.
EXPONER_DOCS=
# Días que se conserva ip_hash antes del borrado automático (§13).
IP_HASH_RETENCION_DIAS=30
OPENAPI_PATH=
