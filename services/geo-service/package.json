{
  "name": "geo-service",
  "version": "0.1.0",
  "private": true,
  "description": "Mi Curichi — servicio geoespacial: point-in-polygon, capas, teselas, agregados, puntos críticos (Parte 4)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/servidor.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/sensible": "6.0.5",
    "contracts": "workspace:*",
    "db": "workspace:*",
    "fastify": "5.12.4",
    "geojson-vt": "4.0.3",
    "pg": "8.23.0",
    "vt-pbf": "3.1.3",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
