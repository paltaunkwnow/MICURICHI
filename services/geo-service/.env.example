GEO_SERVICE_PORT=3002
GEO_SERVICE_HOST=127.0.0.1
DATABASE_URL=postgresql://curichi:curichi@127.0.0.1:5433/curichi
CORS_ORIGENES=http://localhost:3000,http://localhost:3100
UMBRAL_TESELAS_BYTES=5242880
TOLERANCIA_SIMPLIFICACION=0.00003
# Carpeta con salidas del ETL (por defecto ../../data/processed)
DIR_PROCESSED=
# Token compartido con api-core para /geo/v1/capas/invalidar (ruta interna).
# Vacío = solo se acepta desde loopback. Obligatorio si los servicios no comparten host.
GEO_TOKEN_INTERNO=
# Peticiones por minuto y por IP. Amplio: el mapa pide muchas teselas al mover la vista.
GEO_RATE_LIMIT_POR_MINUTO=600
# Límite de las rutas que consultan PostGIS (resolver, agregados, puntos críticos).
GEO_RATE_LIMIT_CONSULTAS_POR_MINUTO=120
# Poner a 1 SOLO si hay un proxy propio delante que reescriba X-Forwarded-For.
TRUST_PROXY=0
