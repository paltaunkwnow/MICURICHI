{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/ContextosySkills/hooks/contexto.mjs\" uso",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/ContextosySkills/hooks/contexto.mjs\" precompact",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/ContextosySkills/hooks/contexto.mjs\" sesion-compact",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
