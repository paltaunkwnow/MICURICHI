{
  "name": "geodata-etl",
  "version": "0.1.0",
  "private": true,
  "description": "Mi Curichi — ETL shapefile → GeoJSON → PostGIS con mapshaper y reporte de calidad (Parte 5)",
  "type": "module",
  "scripts": {
    "inspect": "tsx src/cli.ts inspect",
    "run:capa": "tsx src/cli.ts run",
    "load": "tsx src/cli.ts load",
    "all": "tsx src/cli.ts all",
    "samples:generar": "tsx src/samples/generar.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@turf/turf": "7.4.0",
    "contracts": "workspace:*",
    "db": "workspace:*",
    "mapshaper": "0.7.61",
    "pg": "8.23.0",
    "rbush": "4.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
