{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "API_CORE_HOST",
    "API_CORE_PORT",
    "API_CORE_URL",
    "CIERRE_PLAZO_MS",
    "COOKIE_SEGURA",
    "CORS_ORIGENES",
    "DATABASE_URL",
    "DATABASE_URL_PG_REAL",
    "DB_ESPERA_CONEXION_MS",
    "DB_IDLE_TX_TIMEOUT_MS",
    "DB_POOL_MAX",
    "DB_STATEMENT_TIMEOUT_MS",
    "DIR_PROCESSED",
    "E2E_ADMIN_EMAIL",
    "E2E_ADMIN_PASSWORD",
    "E2E_PUBLICA_URL",
    "E2E_TECNICO_EMAIL",
    "E2E_TECNICO_PASSWORD",
    "E2E_VECINA_EMAIL",
    "E2E_VECINA_PASSWORD",
    "EXPONER_DOCS",
    "GEO_CACHE_AGREGADOS_MS",
    "GEO_RATE_LIMIT_CONSULTAS_POR_MINUTO",
    "GEO_RATE_LIMIT_POR_MINUTO",
    "GEO_SERVICE_HOST",
    "GEO_SERVICE_PORT",
    "GEO_SERVICE_URL",
    "GEO_TOKEN_INTERNO",
    "HSTS",
    "IP_HASH_RETENCION_DIAS",
    "IP_HASH_SAL",
    "JITTER_SAL",
    "LOGIN_MAX_FALLOS_EMAIL",
    "LOGIN_MAX_FALLOS_IP",
    "LOGIN_PETICIONES_POR_VENTANA",
    "LOGIN_VENTANA_MINUTOS",
    "MANTENIMIENTO_ESPERA_MS",
    "METRICAS_RUTA",
    "METRICAS_TOKEN",
    "NODE_ENV",
    "OPENAPI_PATH",
    "PANEL_ADMIN_URL",
    "PASSWORD_COLA_MAX",
    "PASSWORD_SIN_WORKERS",
    "PASSWORD_WORKERS",
    "PGLITE_DATA_DIR",
    "PGLITE_MAX_CONEXIONES",
    "PGLITE_MEMORIA",
    "PGLITE_PUERTO",
    "PROXY_DE_CONFIANZA",
    "PUBLIC_BASE_URL",
    "RATE_LIMIT_LECTURAS_POR_MINUTO",
    "RATE_LIMIT_REPORTES_POR_HORA",
    "REGISTRO_MAX_POR_IP",
    "REGISTRO_PETICIONES_POR_VENTANA",
    "REGISTRO_VENTANA_MINUTOS",
    "REPORTE_MINUTOS_ENTRE_ENVIOS",
    "S3_ACCESS_KEY",
    "S3_BUCKET",
    "S3_ENDPOINT",
    "S3_ESTILO_RUTA",
    "S3_PLAZO_MS",
    "S3_REGION",
    "S3_SECRET_KEY",
    "SEED_ADMIN_PASSWORD",
    "SEED_TECNICO_PASSWORD",
    "SEED_VECINA_PASSWORD",
    "SESION_DIAS",
    "SESION_IDLE_HORAS",
    "STORAGE_DIR",
    "TOLERANCIA_SIMPLIFICACION",
    "TRUST_PROXY",
    "UMBRAL_TESELAS_BYTES"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["build"]
    }
  }
}
