DATABASE_URL=postgresql://curichi:curichi@127.0.0.1:5433/curichi
# Modo local: carpeta de datos de PGlite (relativa a la raíz del repo si no es absoluta)
PGLITE_DATA_DIR=
PGLITE_MEMORIA=0
# Contraseñas de los usuarios sintéticos del seed (SOLO local)
SEED_ADMIN_PASSWORD=
SEED_TECNICO_PASSWORD=
# [ciudad] CRS métrico (código EPSG, proyección en metros) con el que se mide el radio de los
# puntos críticos (§9.2). Vacío = 32720 (WGS 84 / UTM 20S, Santa Cruz). Otra ciudad: su zona UTM.
CRS_METRICO_EPSG=
# [operación] lock_timeout de cada migración, en ms. Vacío = 10000. Si vence (SQLSTATE 55P03), la
# migración se deshace entera y el CLI sale con 1: reintentar con menos tráfico o subirlo.
MIGRAR_LOCK_TIMEOUT_MS=
