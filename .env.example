# Mi Curichi — variables del entorno LOCAL (Docker Compose).
# Copiar a .env y completar. .env está en .gitignore: nunca se sube al repositorio.
# Ningún valor de este archivo es real (CLAUDE.md §13).

# --- PostgreSQL + PostGIS (servicio `postgis`)
POSTGRES_USER=curichi
POSTGRES_PASSWORD=cambiar_en_local
POSTGRES_DB=curichi
POSTGRES_PORT=5432
DATABASE_URL=postgresql://curichi:cambiar_en_local@localhost:5432/curichi

# --- MinIO, almacenamiento S3-compatible de fotos (servicio `minio`)
MINIO_ROOT_USER=curichi
MINIO_ROOT_PASSWORD=cambiar_en_local
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=fotos
S3_ACCESS_KEY=curichi
S3_SECRET_KEY=cambiar_en_local
S3_REGION=us-east-1

# --- Servicios (se usan a partir de las tareas 5 y 6 de la Fase 1)
API_CORE_PORT=3001
GEO_SERVICE_PORT=3002
