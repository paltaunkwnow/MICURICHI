# Variables de TIEMPO DE EJECUCIÓN: las lee el servidor de Next en cada petición, así que la misma
# imagen sirve a cualquier ciudad y a cualquier despliegue. Ninguna se fija al compilar.

# Adónde reenvía src/proxy.ts /api/* y /geo/*, y de dónde lee el layout la ciudad
# (GET /api/v1/configuracion). Sin valor: los servicios locales de `pnpm dev`.
API_CORE_URL=http://127.0.0.1:3001
GEO_SERVICE_URL=http://127.0.0.1:3002
# 1 solo si hay un proxy propio delante que reescriba X-Forwarded-For. Con 0, src/proxy.ts borra
# las cabeceras de reenvío que mande el navegador antes de reenviar a los servicios.
PROXY_DE_CONFIANZA=0
# 1 añade Strict-Transport-Security. Solo con HTTPS ya funcionando.
HSTS=0

# La URL del panel ya NO se configura acá: la manda api-core en /auth/yo (panel_url), y solo a
# técnico, admin y ejecutivo. Se define en api-core con PANEL_ADMIN_URL.
# La ciudad (nombre, centro, zoom, locale, zona horaria) tampoco: se define en api-core (CIUDAD_*).
