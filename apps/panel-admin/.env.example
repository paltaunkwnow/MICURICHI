# panel-admin — variables de entorno LOCAL (Parte 2). Copiar a .env.local; nunca subir valores reales.
# Ningún valor de este archivo es secreto (CLAUDE.md §13).

# URL interna de api-core: Next reenvía /api/* hacia acá (rewrite en next.config.ts).
API_CORE_URL=http://127.0.0.1:3001

# URL interna de geo-service: Next reenvía /geo/* hacia acá.
GEO_SERVICE_URL=http://127.0.0.1:3002

# Solo para Playwright (opcional): URL donde corre el panel. Por defecto http://localhost:3100.
# PANEL_ADMIN_URL=http://localhost:3100
